APP_NAME="Certify LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker Compose プロジェクト名 (親ディレクトリが日本語のため明示)
COMPOSE_PROJECT_NAME=certify-lms

# Sail ports (Laravel/Sail 慣習に揃える: web=8000, pma=8080, db=3306, mailpit=8025)
# VITE のみ BookShelf=5173 と衝突するため 5174 に逃がす
APP_PORT=8000
VITE_PORT=5174

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=certify_lms
DB_USERNAME=sail
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# CORS (Sanctum Cookie 認証で別オリジン FE を許可する場合は具体的なオリジンをカンマ区切りで指定)
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Sanctum Cookie 認証を受け付ける画面のドメイン(ポート番号まで含める)。未設定なら既定値(下の例の前半)に
# APP_URL のホストとポートが自動で足されるため、同一オリジンで動かす限り設定不要。
# 別オリジンの FE から通知 API などを叩く場合は、指定すると既定値が丸ごと置き換わるので、既定値・APP_URL の分・
# FE のドメインをまとめてカンマ区切りで書く(上の CORS_ALLOWED_ORIGINS にも同じ FE を足す)。例:
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1,localhost:8000,fe.example.test:5173

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Google Calendar 連携(S-A-01)。コーチが自分の Google アカウントを任意連携するために使う。
# 取得手順は README.md を参照。未設定でも面談機能は従来どおり動作する。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/settings/google-calendar/callback

# Stripe(追加面談パックの購入・S-A-03)。テストモードのシークレットキーと、
# stripe listen が表示する Webhook 署名シークレットを設定する。詳細は README を参照。
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Gemini(受講生の AI 相談・S-A-02)。Google AI Studio で取得した API キーを設定する。
# 未設定でも画面は開くが、AI 相談は利用できない旨の案内になる。取得手順は README を参照。
GEMINI_API_KEY=

# AI 相談の機能スイッチ。false にすると画面もルートも消える(サイドバーの項目も自動で消える)。
AI_CHAT_ENABLED=true

# 受講生 1 人あたりの 1 日の送信上限。超過すると HTTP 429 を返す。
# ⚠️ Gemini の無料枠は「モデルごとに 1 日 20 リクエスト」。これはプロジェクト全体の枠なので、
#    この値を大きくすると 1 人で使い切ってしまう（課金を有効にした環境では増やしてよい）。
AI_CHAT_DAILY_MESSAGE_LIMIT=5

# 会話タイトルの自動生成。false にすると作成時の仮タイトルのままになる。
AI_CHAT_AUTO_TITLE=true

# 以下はいずれも config/ai-chat.php の既定値を上書きするためのもの（未設定でよい）。
# AI_CHAT_GEMINI_MODEL=gemini-3.8-flash          # 使用モデル
# AI_CHAT_GEMINI_TIMEOUT=30                      # 応答待ちの上限（秒）
# AI_CHAT_HISTORY_LIMIT=10                       # Gemini へ引き継ぐ直近のやり取りの通数
# AI_CHAT_SECTION_EXCERPT_LENGTH=1000            # 教材本文を添える文字数（先頭から）

# 管理者ダッシュボードの集計(受講中 / 修了 / 学習中止の件数・資格別修了率)をキャッシュする秒数(T-A-06)。
# 受講状態が変わったときは期限前でも消えるので、この値は資格名の変更などが反映されるまでの遅れにだけ効く。
# 0 にするとキャッシュせず毎回集計する。config/dashboard.php の既定値を上書きするためのもの（未設定でよい）。
# DASHBOARD_ADMIN_CACHE_TTL_SECONDS=300
